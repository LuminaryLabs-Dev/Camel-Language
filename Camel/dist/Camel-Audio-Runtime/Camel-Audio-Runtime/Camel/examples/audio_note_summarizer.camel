record Transcript {
    string text;
    string language;
}

record NoteSummary {
    string topic;
    string summary;
    string[] keyPoints;
    string[] actionItems;
    string[] uncertainties;
}

policy LocalOnly {
    maxToolCalls = 0;
    allowNetwork = false;
    allowFileRead = false;
    allowShell = false;
}

agent AudioTranscriber {
    model = env("CAMEL_AUDIO_MODEL", "LiquidAI/LFM2.5-Audio-1.5B-GGUF");
    system = "Perform automatic speech recognition. Transcribe the supplied audio faithfully. Preserve names, numbers, and technical terms when audible. Do not summarize, infer missing words, or invent content. Return only the Transcript record.";
    policy = LocalOnly;
    response = Transcript;
    maxTurns = 1;
    retries = 1;
}

agent NoteSummarizer {
    model = env("CAMEL_SUMMARY_MODEL", "LiquidAI/LFM2.5-1.2B-Thinking");
    system = "You summarize meeting and voice notes. Prioritize information relevant to the requested topic. Separate confirmed points from uncertainty, extract concrete action items, and do not add facts absent from the transcript. Return only the NoteSummary record.";
    policy = LocalOnly;
    response = NoteSummary;
    maxTurns = 2;
    retries = 1;
}

workflow Main(string audioPath, string topic = "general") {
    if (audioPath == "") {
        throw "Provide an audio file path as the first workflow argument.";
    }

    AgentResult transcriptResult = await AudioTranscriber.run(new {
        text = "Transcribe this audio recording.",
        audio = [audioPath]
    });

    string transcript = transcriptResult.data.text;
    log($"TRANSCRIPT\n{transcript}");

    AgentResult summaryResult = await NoteSummarizer.run($"Requested topic: {topic}\n\nTranscript:\n{transcript}");
    log($"SUMMARY_JSON\n{json.stringify(summaryResult.data)}");
}
